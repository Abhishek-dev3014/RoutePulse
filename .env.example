# Local-only demo defaults. Docker Compose passes a PostgreSQL URL to the API.
POSTGRES_PASSWORD=routepulse_local_demo
# For native development, the API defaults to durable SQLite ./routepulse.db.
# DATABASE_URL=postgresql+psycopg://routepulse:routepulse_local_demo@localhost:5432/routepulse
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1
